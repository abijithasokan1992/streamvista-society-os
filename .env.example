# Browser + server authentication (Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VISTA_FOUNDER_EMAILS=

# Explicit approval signing
VISTA_APPROVAL_SECRET=

# Server-only audit + persistent memory storage
VISTA_SUPABASE_URL=
VISTA_SUPABASE_SERVICE_ROLE_KEY=
VISTA_AUDIT_REQUIRED=true
VISTA_MEMORY_REQUIRED=false

# Optional AI reasoning/planning bridge. Deterministic planning is used when unbound.
VISTA_REASONING_BRIDGE_URL=
VISTA_REASONING_BRIDGE_TOKEN=

# iPhone / voice read-only operator gateway
VISTA_COMMAND_SECRET=
VISTA_SHORTCUT_ACTOR_ID=
VISTA_SHORTCUT_ACTOR_EMAIL=

# Connector bridges
VISTA_GITHUB_BRIDGE_URL=
VISTA_GITHUB_BRIDGE_TOKEN=
VISTA_MAIL_BRIDGE_URL=
VISTA_MAIL_BRIDGE_TOKEN=
VISTA_CALENDAR_BRIDGE_URL=
VISTA_CALENDAR_BRIDGE_TOKEN=
VISTA_DEPLOYMENT_BRIDGE_URL=
VISTA_DEPLOYMENT_BRIDGE_TOKEN=
VISTA_BUSINESS_BRIDGE_URL=
VISTA_BUSINESS_BRIDGE_TOKEN=

# Backward-compatible fallback only; prefer per-connector tokens above.
VISTA_BRIDGE_TOKEN=
